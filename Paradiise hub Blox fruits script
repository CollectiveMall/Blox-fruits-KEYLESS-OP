-- // 5. AUTOFARM ENGINE – BLOX FRUITS NPC SLAYER
-- // ============================================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")

local currentTarget = nil
local attackCooldown = false
local lootCooldown = false

-- // DETECT NPCS
local function IsNPC(model)
    if not model or not model:IsA("Model") then return false end
    if not model:FindFirstChild("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if model.Humanoid.Health <= 0 then return false end
    
    local name = model.Name:lower()
    -- Common Blox Fruits NPC name patterns
    if name:find("npc") or name:find("enemy") or name:find("boss") or 
       name:find("marine") or name:find("pirate") or name:find("bandit") or 
       name:find("savage") or name:find("island") or name:find("guard") or
       name:find("soldier") or name:find("raider") then
        return true
    end
    
    -- Check parent folder
    if model.Parent and model.Parent:IsA("Folder") then
        local parentName = model.Parent.Name:lower()
        if parentName:find("npc") or parentName:find("enemy") or parentName:find("boss") then
            return true
        end
    end
    
    return false
end

-- // FIND NEAREST NPC
local function FindNearestNPC(range)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return nil end
    local pos = char.PrimaryPart.Position
    local nearest = nil
    local nearestDist = range

    for _, obj in pairs(Workspace:GetDescendants()) do
        if IsNPC(obj) then
            local root = obj.HumanoidRootPart
            if root and root.Position then
                local dist = (pos - root.Position).Magnitude
                if dist < nearestDist then
                    nearest = obj
                    nearestDist = dist
                end
            end
        end
    end
    return nearest, nearestDist
end

-- // MOVE TO TARGET
local function MoveToTarget(target)
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    local root = target:FindFirstChild("HumanoidRootPart")
    if not root then return end
    humanoid:MoveTo(root.Position)
end

-- // ATTACK NPC (RELIABLE METHOD)
local function AttackNPC(target)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local root = target:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Face target
    char.PrimaryPart.CFrame = CFrame.lookAt(char.PrimaryPart.Position, root.Position)

    -- Method 1: Click simulation
    local mouse = LocalPlayer:GetMouse()
    if mouse then
        local camera = Workspace.CurrentCamera
        if camera then
            local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
            if onScreen then
                pcall(function()
                    mouse.Move(mouse, screenPos.X, screenPos.Y)
                    mouse.Button1Down(mouse)
                    task.wait(0.05)
                    mouse.Button1Up(mouse)
                end)
            end
        end
    end

    -- Method 2: VirtualUser (more reliable)
    pcall(function()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)

    -- Method 3: Key press for abilities
    pcall(function()
        VirtualUser:KeyDown("Q")
        task.wait(0.1)
        VirtualUser:KeyUp("Q")
    end)
end

-- // LOOT ITEMS
local function LootNearbyItems()
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local pos = char.PrimaryPart.Position
    local range = 20

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            local name = obj.Name:lower()
            if name:find("fruit") or name:find("chest") or name:find("loot") or name:find("money") then
                local root = obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("Part") and obj)
                if root and root.Position then
                    local dist = (pos - root.Position).Magnitude
                    if dist < range then
                        local humanoid = char:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid:MoveTo(root.Position)
                            task.wait(0.2)
                            -- Click to pick up
                            local mouse = LocalPlayer:GetMouse()
                            if mouse then
                                local camera = Workspace.CurrentCamera
                                if camera then
                                    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                                    if onScreen then
                                        pcall(function()
                                            mouse.Move(mouse, screenPos.X, screenPos.Y)
                                            mouse.Button1Down(mouse)
                                            task.wait(0.05)
                                            mouse.Button1Up(mouse)
                                        end)
                                    end
                                end
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end

-- // MAIN AUTOFARM LOOP
local function AutoFarmLoop()
    while isUnlocked and RunService.Heartbeat do
        -- Check if farm toggle exists and is true
        local farmEnabled = farmToggle and farmToggle.Value or false
        
        if not farmEnabled then
            if AutoFarmGroup and AutoFarmGroup.Objects then
                for _, obj in pairs(AutoFarmGroup.Objects) do
                    if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                        obj.Text = "Status: Idle"
                    end
                end
            end
            task.wait(0.5)
            goto continue
        end

        local range = 150
        -- Get range from slider safely
        if Options and Options.FarmDistance then
            range = Options.FarmDistance.Value or 150
        end
        
        local target, dist = FindNearestNPC(range)

        if target then
            currentTarget = target
            -- Update status
            if AutoFarmGroup and AutoFarmGroup.Objects then
                for _, obj in pairs(AutoFarmGroup.Objects) do
                    if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                        obj.Text = "Status: Farming " .. target.Name .. " (" .. math.floor(dist) .. "m)"
                    end
                end
            end

            -- Walk to target
            if Options and Options.WalkToNPC and Options.WalkToNPC.Value then
                MoveToTarget(target)
            end

            -- Attack
            if not attackCooldown then
                attackCooldown = true
                AttackNPC(target)
                local delay = 0.3
                if Options and Options.AttackDelay then
                    delay = Options.AttackDelay.Value or 0.3
                end
                task.wait(delay)
                attackCooldown = false
            end

            -- Loot
            if Options and Options.LootItems and Options.LootItems.Value and not lootCooldown then
                lootCooldown = true
                LootNearbyItems()
                task.wait(0.5)
                lootCooldown = false
            end

            -- Check if target is dead
            if target.Humanoid.Health <= 0 then
                currentTarget = nil
                if AutoFarmGroup and AutoFarmGroup.Objects then
                    for _, obj in pairs(AutoFarmGroup.Objects) do
                        if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                            obj.Text = "Status: Target defeated, searching..."
                        end
                    end
                end
                task.wait(0.5)
            end
        else
            if AutoFarmGroup and AutoFarmGroup.Objects then
                for _, obj in pairs(AutoFarmGroup.Objects) do
                    if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                        obj.Text = "Status: Searching for NPCs..."
                    end
                end
            end
            currentTarget = nil
            task.wait(0.3)
        end

        ::continue::
        task.wait(0.1)
    end
end

-- // START AUTOFARM LOOP
spawn(AutoFarmLoop)

