local function UnlockGUI()
    if keyBox.Text == CORRECT_KEY then
        isUnlocked = true
        keyOverlay:Destroy() -- Remove overlay
        Window.Visible = true -- Show main GUI
        -- Create tabs after unlock (we'll do this now)
        CreateTabs()
        -- Notify
        Library:Notify({
            Title = "🔓 Paradise Unlocked",
            Description = "Welcome to Paradise Hub, fren!",
            Time = 4,
        })
        print("[Paradise Hub] Unlocked successfully.")
    else
        errorLabel.Text = "❌ Incorrect key. Try again."
        keyBox.Text = ""
        -- Shake animation (simple)
        keyFrame.Position = UDim2.new(0.5, -200, 0.5, -100)
        for i = 1, 5 do
            task.wait(0.05)
            keyFrame.Position = UDim2.new(0.5, -200 + (i%2==0 and 10 or -10), 0.5, -100)
        end
        keyFrame.Position = UDim2.new(0.5, -200, 0.5, -100)
    end
end

