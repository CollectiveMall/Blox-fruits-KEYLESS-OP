-- Unlock Function
local function UnlockGUI()
    if keyBox.Text == CORRECT_KEY then
        isUnlocked = true
        keyGui:Destroy() -- Remove the key GUI
        StarterGui:SetCore("SendNotification", {
            Title = "🔓 Paradise Unlocked",
            Text = "Welcome, fren!",
            Duration = 4,
        })
        print("[Paradise Hub] Unlocked.")
        -- Now load the full Obsidian hub
        LoadObsidianGUI()
    else
        errorLabel.Text = "❌ Incorrect key. Try again."
        keyBox.Text = ""
        -- Shake animation
        for i = 1, 5 do
            task.wait(0.05)
            keyFrame.Position = UDim2.new(0.5, -200 + (i%2==0 and 10 or -10), 0.5, -110)
        end
        keyFrame.Position = UDim2.new(0.5, -200, 0.5, -110)
    end
end

unlockBtn.MouseButton1Click:Connect(UnlockGUI)
keyBox.FocusLost:Connect(function(enterPressed)
