-- 5. ESP TAB (PLAYER + DEVIL FRUIT ESP)
-- ------------------------------------------
local PlayerESPSection = ESPTab:CreateSection("Player Visuals")
local FruitESPSection  = ESPTab:CreateSection("World & Items")

local PlayerESP_Enabled = false
local FruitESP_Enabled  = false

local PlayerHighlights = {}
local FruitHighlights  = {}

-- Helper to apply Highlights
local function ApplyHighlight(obj, color, storageTable, key)
    if not obj or not obj:Parent then return end
    if not obj:FindFirstChild("ParadiseHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ParadiseHighlight"
        hl.FillColor = color
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.OutlineTransparency = 0
        hl.Adornee = obj
        hl.Parent = obj
        storageTable[key] = hl
    end
end

-- Clear highlights helper
local function ClearHighlights(storageTable)
    for k, hl in pairs(storageTable) do
        if hl then hl:Destroy() end
    end
    table.clear(storageTable)
end

-- Player ESP Toggle
PlayerESPSection:CreateToggle({
    Name = "Player ESP",
    CurrentValue = false,
    Callback = function(Value)
        PlayerESP_Enabled = Value
        if not Value then
            ClearHighlights(PlayerHighlights)
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    ApplyHighlight(player.Character, Color3.fromRGB(255, 0, 80), PlayerHighlights, player.UserId)
                end
            end
        end
    end
})

-- Devil Fruit ESP Toggle
FruitESPSection:CreateToggle({
    Name = "Devil Fruit ESP",
    CurrentValue = false,
    Callback = function(Value)
        FruitESP_Enabled = Value
        if not Value then
            ClearHighlights(FruitHighlights)
        else
            -- Scan workspace for dropped/spawned fruits
            for _, item in pairs(Workspace:GetChildren()) do
                if item:IsA("Tool") or string.find(item.Name, "Fruit") then
                    ApplyHighlight(item, Color3.fromRGB(255, 170, 0), FruitHighlights, item:GetDebugId())
                end
            end
        end
    end
})

-- Detect newly spawned Devil Fruits in real time
Workspace.ChildAdded:Connect(function(child)
    if FruitESP_Enabled then
        task.wait(0.5)
        if child:IsA("Tool") or string.find(child.Name, "Fruit") then
            ApplyHighlight(child, Color3.fromRGB(255, 170, 0), FruitHighlights, child:GetDebugId())
        end
    end
end)

