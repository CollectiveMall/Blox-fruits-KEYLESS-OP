local espObjects = {}

local function ClearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then pcall(obj.Destroy, obj) end
    end
    espObjects = {}
end

local function UpdateESP()
    if not espToggle or not isUnlocked then
        ClearESP()
        return
    end
    ClearESP()
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local pos = char.PrimaryPart.Position

    -- Players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Position then
                local dist = (pos - root.Position).Magnitude
                if dist <= espRange then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = player.Character
                    hl.FillColor = Color3.new(0, 0.8, 0.9)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.new(1,1,1)
                    hl.OutlineTransparency = 0.2
                    hl.Parent = player.Character
                    table.insert(espObjects, hl)
                    -- Billboard
                    local bill = Instance.new("BillboardGui")
                    bill.Adornee = root
                    bill.Size = UDim2.new(0, 200, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 4, 0)
                    bill.MaxDistance = 500
                    bill.AlwaysOnTop = true
                    local lbl = Instance.new("TextLabel", bill)
                    lbl.Size = UDim2.new(1,0,1,0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = player.Name .. " | " .. math.floor(dist) .. "m"
                    lbl.TextColor3 = Color3.new(0, 0.8, 0.9)
                    lbl.TextStrokeColor3 = Color3.new(0,0,0)
                    lbl.TextStrokeTransparency = 0.3
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 14
                    bill.Parent = player.Character
                    table.insert(espObjects, bill)
                end
            end
        end
    end

    -- NPCs
    for _, obj in pairs(Workspace:GetDescendants()) do
        if IsNPC(obj) then
            local root = obj.HumanoidRootPart
            if root and root.Position then
                local dist = (pos - root.Position).Magnitude
                if dist <= espRange then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = obj
                    hl.FillColor = Color3.new(1, 0.7, 0.1)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.new(1,1,1)
                    hl.OutlineTransparency = 0.2
                    hl.Parent = obj
                    table.insert(espObjects, hl)
                    local bill = Instance.new("BillboardGui")
                    bill.Adornee = root
                    bill.Size = UDim2.new(0, 200, 0, 40)
                    bill.StudsOffset = Vector3.new(0, 4, 0)
                    bill.MaxDistance = 500
                    bill.AlwaysOnTop = true
                    local lbl = Instance.new("TextLabel", bill)
                    lbl.Size = UDim2.new(1,0,1,0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = obj.Name .. " | " .. math.floor(dist) .. "m"
                    lbl.TextColor3 = Color3.new(1, 0.7, 0.1)
                    lbl.TextStrokeColor3 = Color3.new(0,0,0)
                    lbl.TextStrokeTransparency = 0.3
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 14
                    bill.Parent = obj
                    table.insert(espObjects, bill)
                end
            end
        end
    end
end

