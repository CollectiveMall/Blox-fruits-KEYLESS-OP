-- ============================================================
--  PARADISE HUB – BLOX FRUITS EDITION
--  Community: Paradise Hub
--  Key: OHPARADISENOTAGAIN!
--  UI: Obsidian (deividcomsono)
-- ============================================================

-- // Safety: prevent double execution
if getgenv().ParadiseHubLoaded then
    return
end
getgenv().ParadiseHubLoaded = true

-- // Load Obsidian UI Library
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

-- // Configuration
Library.ForceCheckbox = false
Library.ShowToggleFrameInKeybinds = true

-- // Key System (hardcoded)
local CORRECT_KEY = "OHPARADISENOTAGAIN!"
local keyVerified = false

-- // Create Key UI (simple popup)
local function showKeyUI()
    local keyScreenGui = Instance.new("ScreenGui")
    keyScreenGui.Name = "ParadiseKeyGUI"
    keyScreenGui.Parent = game:GetService("CoreGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 400, 0, 200)
    frame.Position = UDim2.new(0.5, -200, 0.5, -100)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = keyScreenGui

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = "🔑 Paradise Hub"
    title.TextColor3 = Color3.fromRGB(255, 200, 100)
    title.TextSize = 28
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- Input
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.8, 0, 0, 40)
    input.Position = UDim2.new(0.1, 0, 0, 60)
    input.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.TextSize = 18
    input.Font = Enum.Font.Gotham
    input.PlaceholderText = "Enter key..."
    input.Parent = frame

    -- Submit button
    local submit = Instance.new("TextButton")
    submit.Size = UDim2.new(0.4, 0, 0, 40)
    submit.Position = UDim2.new(0.3, 0, 0, 120)
    submit.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
    submit.TextColor3 = Color3.fromRGB(255, 255, 255)
    submit.TextSize = 20
    submit.Font = Enum.Font.GothamBold
    submit.Text = "Unlock"
    submit.Parent = frame

    submit.MouseButton1Click:Connect(function()
        if input.Text == CORRECT_KEY then
            keyVerified = true
            keyScreenGui:Destroy()
            createMainUI() -- Now build the real GUI
        else
            input.Text = "Wrong key!"
            input.TextColor3 = Color3.fromRGB(255, 50, 50)
            wait(1)
            input.Text = ""
            input.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)
end

-- // Main UI Creation
local function createMainUI()
    local Window = Library:CreateWindow({
        Title = "Paradise Hub",
        Footer = "Community Edition",
        Icon = 0,
        NotifySide = "Right",
        ShowCustomCursor = true,
        Resizable = true,
        Center = true,
        AutoShow = true,
    })

    -- // Define Tabs (order: AutoFarm, ESP, Utility, Setting, Game Settings)
    local Tabs = {
        AutoFarm = Window:AddTab("AutoFarm", "sword"),
        ESP = Window:AddTab("ESP", "eye"),
        Utility = Window:AddTab("Utility", "wrench"),
        Setting = Window:AddTab("Setting", "settings"),
        GameSettings = Window:AddTab("Game Settings", "gamepad-2"),
    }

    -- ============================================================
    --  TAB 1: AUTOFARM
    -- ============================================================
    local autoFarmGroup = Tabs.AutoFarm:AddLeftGroupbox("Farming Controls", "farm")
    autoFarmGroup:AddToggle("AutoFarmToggle", {
        Text = "Enable Auto Farm",
        Tooltip = "Farms nearest NPCs based on your level",
        Default = false,
        Callback = function(v)
            print("[Paradise] Auto Farm:", v)
            -- Place your auto-farm logic here
        end
    })
    autoFarmGroup:AddToggle("AutoQuest", {
        Text = "Auto Quest",
        Tooltip = "Automatically accepts and completes quests",
        Default = false,
        Callback = function(v)
            print("[Paradise] Auto Quest:", v)
        end
    })
    autoFarmGroup:AddDropdown("FarmMode", {
        Text = "Farm Mode",
        Tooltip = "Choose your farming strategy",
        Values = {"Level", "Boss", "Chests"},
        Default = 1,
        Callback = function(v)
            print("[Paradise] Farm Mode:", v)
        end
    })

    -- ============================================================
    --  TAB 2: ESP (with toggle)
    -- ============================================================
    local espGroup = Tabs.ESP:AddLeftGroupbox("Player ESP", "eye")
    
    -- Master ESP Toggle
    espGroup:AddToggle("ESPMasterToggle", {
        Text = "Enable ESP",
        Tooltip = "Show/hide all ESP elements",
        Default = false,
        Callback = function(v)
            getgenv().ESPEnabled = v
            if not v then
                -- Remove all highlights
                for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                    if plr ~= game.Players.LocalPlayer and plr.Character then
                        local hl = plr.Character:FindFirstChild("ParadiseHighlight")
                        if hl then hl:Destroy() end
                    end
                end
            else
                -- Refresh ESP for all players
                refreshESP()
            end
        end
    })

    -- Color pickers for enemy/allies (with defaults)
    espGroup:AddColorPicker("EnemyColor", {
        Default = Color3.fromRGB(255, 50, 50),
        Title = "Enemy Color",
        Callback = function(c)
            getgenv().EnemyColor = c
            if getgenv().ESPEnabled then refreshESP() end
        end
    })
    espGroup:AddColorPicker("AllyColor", {
        Default = Color3.fromRGB(50, 255, 50),
        Title = "Ally Color",
        Callback = function(c)
            getgenv().AllyColor = c
            if getgenv().ESPEnabled then refreshESP() end
        end
    })

    -- Additional ESP options
    espGroup:AddToggle("ESPTeamCheck", {
        Text = "Team Check",
        Tooltip = "Color enemies red, allies green (based on team)",
        Default = true,
        Callback = function(v)
            getgenv().ESPTeamCheck = v
            if getgenv().ESPEnabled then refreshESP() end
        end
    })

    -- // ESP Core Functions
    getgenv().ESPEnabled = false
    getgenv().EnemyColor = Color3.fromRGB(255, 50, 50)
    getgenv().AllyColor = Color3.fromRGB(50, 255, 50)
    getgenv().ESPTeamCheck = true

    local function applyESP(player)
        if player == game.Players.LocalPlayer then return end
        if not player.Character then return end
        if not getgenv().ESPEnabled then return end

        -- Remove old highlight
        local old = player.Character:FindFirstChild("ParadiseHighlight")
        if old then old:Destroy() end

        local hl = Instance.new("Highlight")
        hl.Name = "ParadiseHighlight"
        hl.Parent = player.Character
        hl.FillColor = getgenv().EnemyColor
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0.2
        hl.Adornee = player.Character

        -- Team-based coloring if enabled
        if getgenv().ESPTeamCheck then
            local localTeam = game.Players.LocalPlayer.Team
            if player.Team and localTeam then
                if player.Team == localTeam then
                    hl.FillColor = getgenv().AllyColor
                else
                    hl.FillColor = getgenv().EnemyColor
                end
            end
        end
    end

    local function refreshESP()
        for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
            applyESP(plr)
        end
    end

    -- Hook player events
    game:GetService("Players").PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function()
            wait(0.5)
            applyESP(plr)
        end)
        -- If character already exists
        if plr.Character then
            wait(0.5)
            applyESP(plr)
        end
    end)

    game:GetService("Players").PlayerRemoving:Connect(function(plr)
        if plr.Character then
            local hl = plr.Character:FindFirstChild("ParadiseHighlight")
            if hl then hl:Destroy() end
        end
    end)

    -- Also handle local player's team change (re-color all)
    game.Players.LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
        if getgenv().ESPEnabled then refreshESP() end
    end)

    -- ============================================================
    --  TAB 3: UTILITY
    -- ============================================================
    local utilGroup = Tabs.Utility:AddLeftGroupbox("Teleports & More", "zap")
    utilGroup:AddButton({
        Text = "Teleport to Island (Sea 1)",
        Func = function()
            print("[Paradise] Teleporting to Sea 1...")
            -- Place teleport logic here
        end,
        Tooltip = "Warp to Jungle Island"
    })
    utilGroup:AddButton({
        Text = "Teleport to Island (Sea 2)",
        Func = function()
            print("[Paradise] Teleporting to Sea 2...")
        end,
        Tooltip = "Warp to Kingdom of Rose"
    })
    utilGroup:AddToggle("SpeedHack", {
        Text = "Speed Hack",
        Tooltip = "Increase movement speed (use at own risk)",
        Default = false,
        Callback = function(v)
            print("[Paradise] Speed Hack:", v)
        end
    })
    utilGroup:AddToggle("FlyMode", {
        Text = "Fly Mode",
        Tooltip = "Enable flight (hold space to ascend)",
        Default = false,
        Callback = function(v)
            print("[Paradise] Fly Mode:", v)
        end
    })

    -- ============================================================
    --  TAB 4: SETTING
    -- ============================================================
    local settingsGroup = Tabs.Setting:AddLeftGroupbox("UI Settings", "sliders")
    settingsGroup:AddToggle("ShowCursor", {
        Text = "Custom Cursor",
        Default = true,
        Callback = function(v)
            Window:SetCustomCursor(v)
        end
    })
    settingsGroup:AddButton({
        Text = "Save Settings",
        Func = function()
            SaveManager:Save()
            Library:Notify("Settings saved!")
        end,
        Tooltip = "Save all current toggles and values"
    })
    settingsGroup:AddButton({
        Text = "Load Settings",
        Func = function()
            SaveManager:Load()
            Library:Notify("Settings loaded!")
        end,
        Tooltip = "Load previously saved settings"
    })
    settingsGroup:AddButton({
        Text = "Reset to Default",
        Func = function()
            SaveManager:Reset()
            Library:Notify("Settings reset to default")
        end,
        Tooltip = "Reset all settings to defaults"
    })

    -- Theme manager (optional)
    local themeGroup = Tabs.Setting:AddRightGroupbox("Theme", "palette")
    ThemeManager:SetLibrary(Library)
    ThemeManager:SetTheme("Dark")
    ThemeManager:AddThemePicker(themeGroup, {
        Default = "Dark",
        Callback = function(theme)
            print("[Paradise] Theme changed to:", theme)
        end
    })

    -- ============================================================
    --  TAB 5: GAME SETTINGS (Rejoin, Unload, Small Servers)
    -- ============================================================
    local gameGroup = Tabs.GameSettings:AddLeftGroupbox("Game Controls", "server")
    gameGroup:AddButton({
        Text = "Rejoin Server",
        Func = function()
            Library:Notify("Rejoining...")
            local ts = game:GetService("TeleportService")
            local placeId = game.PlaceId
            local jobId = game.JobId
            ts:TeleportToPlaceInstance(placeId, jobId, game.Players.LocalPlayer)
        end,
        Tooltip = "Teleport back to the same server"
    })
    gameGroup:AddButton({
        Text = "Unload Script",
        Func = function()
            Library:Notify("Unloading Paradise Hub...")
            getgenv().ParadiseHubLoaded = false
            -- Destroy UI
            for _, v in pairs(game:GetService("CoreGui"):GetChildren()) do
                if v.Name == "ParadiseHubGUI" then
                    v:Destroy()
                end
            end
            -- Remove all highlights
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character then
                    local hl = plr.Character:FindFirstChild("ParadiseHighlight")
                    if hl then hl:Destroy() end
                end
            end
            -- Clear our environment
            getgenv().ESPEnabled = nil
            -- Remove the ScreenGui
            Window:Destroy()
        end,
        Tooltip = "Completely remove the script and its effects",
        Risky = true -- makes button red
    })
    gameGroup:AddButton({
        Text = "Join Small Server",
        Func = function()
            Library:Notify("Searching for a small server...")
            -- Use the game's teleport API to find a server with few players
            local ts = game:GetService("TeleportService")
            local placeId = game.PlaceId
            -- Attempt to teleport to a private server or a server with low population
            -- Note: This is a placeholder – you can implement a more robust method
            ts:Teleport(placeId, game.Players.LocalPlayer)
        end,
        Tooltip = "Attempt to join a server with fewer players"
    })

    -- ============================================================
    --  FINALIZE: SaveManager & ThemeManager
    -- ============================================================
    SaveManager:SetLibrary(Library)
    SaveManager:SetFolder("ParadiseHub/BloxFruits")
    SaveManager:IgnoreThemeSettings() -- we handle theme separately
    SaveManager:SetIgnoreIndexes({}) -- save everything else
    ThemeManager:SetFolder("ParadiseHub/BloxFruits")
    SaveManager:BuildConfigSection(Tabs.Setting) -- adds a config section in the Setting tab
    SaveManager:Load()

    -- // Set the window name for later destruction
    Window.Instance.Name = "ParadiseHubGUI"
end

-- // Entry point: show key UI first
showKeyUI()
