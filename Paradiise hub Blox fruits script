local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local farmActive = false
local farmTarget = nil
local attackCooldown = false

-- // Find nearest NPC
local function FindNearestNPC(range)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return nil end
    local pos = char.PrimaryPart.Position
    local nearest = nil
    local nearestDist = range

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) then
                local root = obj.HumanoidRootPart
                local dist = (pos - root.Position).Magnitude
                if dist < nearestDist and obj.Humanoid.Health > 0 then
                    nearest = obj
                    nearestDist = dist
                end
            end
        end
    end
    return nearest
end

-- // Attack NPC (simulate click or ability)
local function AttackNPC(target)
    if not target or not target.PrimaryPart then return end
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end

    -- Face target
    char.PrimaryPart.CFrame = CFrame.lookAt(char.PrimaryPart.Position, target.PrimaryPart.Position)

    -- Simulate mouse click (for combat)
    local mouse = LocalPlayer:GetMouse()
    if mouse then
        -- Get screen position of target
        local camera = Workspace.CurrentCamera
        local screenPos, onScreen = camera:WorldToViewportPoint(target.PrimaryPart.Position)
        if onScreen then
            mouse.Move(mouse, screenPos.X, screenPos.Y)
            mouse.Button1Down(mouse)
            task.wait(0.05)
            mouse.Button1Up(mouse)
        end
    end
end

-- // AutoFarm Loop
local function AutoFarmLoop()
    while isUnlocked and RunService.Heartbeat do
        if not Toggles.Farm_Toggle.Value then
            farmActive = false
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Idle")
            end
            task.wait(0.5)
            continue
        end

        farmActive = true
        local range = Options.FarmDistance.Value or 150
        local target = FindNearestNPC(range)

        if target then
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Fighting " .. target.Name)
            end
            if not attackCooldown then
                attackCooldown = true
                AttackNPC(target)
                task.wait(Options.AttackDelay.Value or 0.5)
                attackCooldown = false
            end
        else
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Searching for targets...")
            end
        end
        task.wait(0.2)
    end
end

-- // Start AutoFarm loop
spawn(AutoFarmLoop)

