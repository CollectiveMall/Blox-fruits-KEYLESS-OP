-- ------------------------------------------
-- 5. ESP TAB IMPLEMENTATION
-- ------------------------------------------
local ESPSection = ESPTab:CreateSection("Player Visuals")
local ESP_Enabled = false
local ESP_Highlights = {}

local function ClearESP()
    for _, highlight in pairs(ESP_Highlights) do
        if highlight then
            highlight:Destroy()
        end
    end
    table.clear(ESP_Highlights)
end

local function ApplyESP(player)
    if player == LocalPlayer or not player.Character then return end
    
    if not player.Character:FindFirstChild("ParadiseESP") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ParadiseESP"
        highlight.FillColor = Color3.fromRGB(255, 0, 80)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Adornee = player.Character
        highlight.Parent = player.Character
        
        ESP_Highlights[player.UserId] = highlight
    end
end

ESPSection:CreateToggle({
    Name = "Player ESP",
    CurrentValue = false,
    Callback = function(Value)
        ESP_Enabled = Value
        if not Value then
            ClearESP()
        else
            for _, player in pairs(Players:GetPlayers()) do
                ApplyESP(player)
            end
        end
    end
})

-- Update ESP on character respawn / join
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if ESP_Enabled then
            task.wait(0.5)
            ApplyESP(player)
        end
    end)
end)

