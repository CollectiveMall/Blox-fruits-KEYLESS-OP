-- ------------------------------------------
-- 7. GAME SETTINGS TAB
-- ------------------------------------------
local GameSection = GameSettingsTab:CreateSection("Server Operations")

-- Rejoin Server Button
GameSection:CreateButton({
    Name = "Rejoin server",
    Callback = function()
        if #Players:GetPlayers() <= 1 then
            LocalPlayer:Kick("\n[Paradise Hub] Rejoining Server...")
            task.wait()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        else
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end
    end
})

-- Join Small Servers Button
GameSection:CreateButton({
    Name = "Join small servers",
    Callback = function()
        local placeId = game.PlaceId
        local serversUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(serversUrl))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                    break
                end
            end
        else
            warn("[Paradise Hub] Failed to fetch server list.")
        end
    end
})

-- Unload Script Button
GameSection:CreateButton({
    Name = "Unload Script",
    Callback = function()
        ClearESP()
        Obsidian:Destroy()
        print("[Paradise Hub] Script successfully unloaded.")
    end
})

print("[Paradise Hub] Loaded successfully!")
