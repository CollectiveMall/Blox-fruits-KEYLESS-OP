    -- // NPC DETECTION (Improved)
    local function IsNPC(model)
        if not model or not model:IsA("Model") then return false end
        if not model:FindFirstChild("Humanoid") then return false end
        if not model:FindFirstChild("HumanoidRootPart") then return false end
        if Players:GetPlayerFromCharacter(model) then return false end
        if model.Humanoid.Health <= 0 then return false end
        
        -- Check if it's a valid NPC (not a player, not a dummy)
        local name = model.Name:lower()
        if name:find("npc") or name:find("enemy") or name:find("boss") or
           name:find("marine") or name:find("pirate") or name:find("bandit") or
           name:find("savage") or name:find("island") or name:find("guard") or
           name:find("soldier") or name:find("raider") or name:find("skeleton") or
           name:find("zombie") or name:find("ghoul") or name:find("demon") then
            return true
        end
        
        -- Check parent folder
        if model.Parent and model.Parent:IsA("Folder") then
            local pName = model.Parent.Name:lower()
            if pName:find("npc") or pName:find("enemy") or pName:find("boss") or
               pName:find("monster") or pName:find("creature") then
                return true
            end
        end
        
        return false
    end

    -- // FIND BEST NPC TARGET
    local function FindBestNPC(range)
        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return nil end
        local pos = char.PrimaryPart.Position
        local best = nil
        local bestScore = -math.huge
        
        local targetMode = Options.FarmTarget and Options.FarmTarget.Value or "Closest NPC"
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if IsNPC(obj) then
                local root = obj.HumanoidRootPart
                if root and root.Position then
                    local dist = (pos - root.Position).Magnitude
                    if dist <= range then
                        local score = 0
                        local health = obj.Humanoid.Health
                        local maxHealth = obj.Humanoid.MaxHealth
                        
                        if targetMode == "Closest NPC" then
                            score = -dist
                        elseif targetMode == "Lowest Level" then
                            -- Estimate level from health (higher health = higher level)
                            score = -maxHealth
                        elseif targetMode == "Highest Level" then
                            score = maxHealth
                        elseif targetMode == "Bosses Only" then
                            if obj.Name:lower():find("boss") then
                                score = -dist
                            else
                                score = -math.huge
                            end
                        end
                        
                        -- Prefer lower health targets (faster kills)
                        if health > 0 then
                            score = score + (1 - health/maxHealth) * 10
                        end
                        
                        if score > bestScore then
                            bestScore = score
                            best = obj
                        end
                    end
                end
            end
        end
        return best
    end

    -- // MOVE TO TARGET
    local function MoveToTarget(target)
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChild("Humanoid")
        if not humanoid then return end
        local root = target:FindFirstChild("HumanoidRootPart")
        if not root then return end
        humanoid:MoveTo(root.Position)
    end

    -- // ATTACK NPC (Robust Method)
    local function AttackNPC(target)
        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return end
        local root = target:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        -- Face target
        char.PrimaryPart.CFrame = CFrame.lookAt(char.PrimaryPart.Position, root.Position)
        
        -- Method 1: Mouse Click Simulation
        local mouse = LocalPlayer:GetMouse()
        if mouse then
            local camera = Workspace.CurrentCamera
            if camera then
                local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    pcall(function()
                        mouse.Move(mouse, screenPos.X, screenPos.Y)
                        mouse.Button1Down(mouse)
                        task.wait(0.05)
                        mouse.Button1Up(mouse)
                    end)
                end
            end
        end
        
        -- Method 2: VirtualUser Click
        pcall(function()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
        
        -- Method 3: Key Press (Q for melee, 1-4 for abilities)
        pcall(function()
            VirtualUser:KeyDown("Q")
            task.wait(0.05)
            VirtualUser:KeyUp("Q")
        end)
        
        -- Method 4: Direct Humanoid Damage (Fallback)
        pcall(function()
            if target.Humanoid then
                local humanoid = target.Humanoid
                local damage = 10 -- Base damage
                humanoid:TakeDamage(damage)
            end
        end)
    end

    -- // LOOT ITEMS (Improved)
    local function LootNearbyItems()
        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return end
        local pos = char.PrimaryPart.Position
        local range = 25
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("Tool") then
                local name = obj.Name:lower()
                if name:find("fruit") or name:find("chest") or name:find("loot") or 
                   name:find("money") or name:find("beli") or name:find("drop") then
                    local root = obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("Part") and obj)
                    if root and root.Position then
                        local dist = (pos - root.Position).Magnitude
                        if dist < range then
                            local humanoid = char:FindFirstChild("Humanoid")
                            if humanoid then
                                humanoid:MoveTo(root.Position)
                                task.wait(0.2)
                                
                                -- Click to pick up
                                local mouse = LocalPlayer:GetMouse()
                                if mouse then
                                    local camera = Workspace.CurrentCamera
                                    if camera then
                                        local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                                        if onScreen then
                                            pcall(function()
                                                mouse.Move(mouse, screenPos.X, screenPos.Y)
                                                mouse.Button1Down(mouse)
                                                task.wait(0.05)
                                                mouse.Button1Up(mouse)
                                            end)
                                        end
                                    end
                                end
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    -- // AUTO-COMPLETE QUESTS
    local function AutoCompleteQuests()
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Find quest giver NPCs
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and 
               (obj.Name:lower():find("quest") or obj.Name:lower():find("giver") or 
                obj.Name:lower():find("npc")) then
                local root = obj:FindFirstChild("HumanoidRootPart")
                if root and root.Position then
                    local dist = (char.PrimaryPart.Position - root.Position).Magnitude
                    if dist < 30 then
                        -- Click on quest giver
                        local mouse = LocalPlayer:GetMouse()
                        if mouse then
                            local camera = Workspace.CurrentCamera
                            if camera then
                                local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                                if onScreen then
                                    pcall(function()
                                        mouse.Move(mouse, screenPos.X, screenPos.Y)
                                        mouse.Button1Down(mouse)
                                        task.wait(0.05)
                                        mouse.Button1Up(mouse)
                                        task.wait(0.5)
                                        -- Click again to accept/turn in
                                        mouse.Button1Down(mouse)
                                        task.wait(0.05)
                                        mouse.Button1Up(mouse)
                                    end)
                                end
                            end
                        end
                        break
                    end
                end
            end
        end
    end

    -- // MAIN AUTOFARM LOOP
    local function AutoFarmLoop()
        while isUnlocked do
            if not Toggles.Farm_Toggle.Value then
                farmActive = false
                if AutoFarmGroup and AutoFarmGroup.Objects then
                    for _, obj in pairs(AutoFarmGroup.Objects) do
                        if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                            obj.Text = "Status: Idle"
                        end
                    end
                end
                task.wait(0.5)
                goto continue
            end

            farmActive = true
            local range = Options.FarmDistance and Options.FarmDistance.Value or 200
            
            -- Find best target
            local target = FindBestNPC(range)
            
            if target then
                currentTarget = target
                local dist = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and 
                             (LocalPlayer.Character.PrimaryPart.Position - target.HumanoidRootPart.Position).Magnitude) or 0
                
                -- Update status
                if AutoFarmGroup and AutoFarmGroup.Objects then
                    for _, obj in pairs(AutoFarmGroup.Objects) do
                        if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                            obj.Text = "Status: Farming " .. target.Name .. " (" .. math.floor(dist) .. "m)"
                        end
                    end
                end
                
                -- Walk to target
                if Toggles.WalkToNPC and Toggles.WalkToNPC.Value then
                    MoveToTarget(target)
                end
                
                -- Attack
                if not attackCooldown then
                    attackCooldown = true
                    AttackNPC(target)
                    local delay = Options.AttackDelay and Options.AttackDelay.Value or 0.2
                    task.wait(delay)
                    attackCooldown = false
                end
                
                -- Loot items
                if Toggles.LootItems and Toggles.LootItems.Value and not lootCooldown then
                    lootCooldown = true
                    LootNearbyItems()
                    task.wait(0.5)
                    lootCooldown = false
                end
                
                -- Auto quest
                if Toggles.AutoQuest and Toggles.AutoQuest.Value and not questCooldown then
                    questCooldown = true
                    AutoCompleteQuests()
                    task.wait(2)
                    questCooldown = false
                end
                
                -- Check if target is dead
                if target.Humanoid.Health <= 0 then
                    currentTarget = nil
                    if AutoFarmGroup and AutoFarmGroup.Objects then
                        for _, obj in pairs(AutoFarmGroup.Objects) do
                            if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                                obj.Text = "Status: Target defeated, searching..."
                            end
                        end
                    end
                    task.wait(0.5)
                end
            else
                if AutoFarmGroup and AutoFarmGroup.Objects then
                    for _, obj in pairs(AutoFarmGroup.Objects) do
                        if obj:IsA("TextLabel") and obj.Text and obj.Text:find("Status:") then
                            obj.Text = "Status: Searching for NPCs..."
                        end
                    end
                end
                currentTarget = nil
                task.wait(0.3)
            end

            ::continue::
            task.wait(0.1)
        end
    end

    -- Start AutoFarm loop
    spawn(AutoFarmLoop)

