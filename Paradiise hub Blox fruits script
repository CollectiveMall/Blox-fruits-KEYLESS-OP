-- ------------------------------------------
-- 1. KEY SYSTEM VALIDATION
-- ------------------------------------------
local CORRECT_KEY = "OHPARADISENOTAGAIN!"
local KeyValidated = false

-- Quick key prompt using Roblox CoreGui / Command Line or UI
local function PromptKey()
    print("[Paradise Hub] Key required to load Paradise Hub.")
    -- Replace this variable with your custom Key UI or prompt logic if needed
    local userKey = CORRECT_KEY -- Set default for script execution

    if userKey == CORRECT_KEY then
        KeyValidated = true
        print("[Paradise Hub] Key accepted! Loading Hub...")
    else
        warn("[Paradise Hub] Invalid key provided.")
    end
end

PromptKey()

if not KeyValidated then 
    return 
end

