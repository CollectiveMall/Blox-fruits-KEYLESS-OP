    local ESPObjects = {
        Highlights = {},
        Billboards = {},
        Lines = {},
        Glows = {},
    }

    function ClearESP()
        for _, v in pairs(ESPObjects.Highlights) do
            if v and v.Parent then pcall(v.Destroy, v) end
        end
        for _, v in pairs(ESPObjects.Billboards) do
            if v and v.Parent then pcall(v.Destroy, v) end
        end
        for _, v in pairs(ESPObjects.Lines) do
            if v and v.Parent then pcall(v.Destroy, v) end
        end
        for _, v in pairs(ESPObjects.Glows) do
            if v and v.Parent then pcall(v.Destroy, v) end
        end
        ESPObjects = { Highlights = {}, Billboards = {}, Lines = {}, Glows = {} }
    end

    local function CreateBillboard(adornee, text, color, offset)
        local bill = Instance.new("BillboardGui")
        bill.Adornee = adornee
        bill.Size = UDim2.new(0, 200, 0, 40)
        bill.StudsOffset = offset or Vector3.new(0, 3, 0)
        bill.MaxDistance = 500
        bill.AlwaysOnTop = true
        local label = Instance.new("TextLabel", bill)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = color
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextStrokeTransparency = 0.3
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        return bill
    end

    local function CreateHighlight(adornee, color)
        local hl = Instance.new("Highlight")
        hl.Adornee = adornee
        hl.FillColor = color
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        return hl
    end

    local function UpdateESP()
        if not Toggles.ESP_Toggle.Value then
            ClearESP()
            return
        end

        local maxDist = Options.DistanceSlider and Options.DistanceSlider.Value or 250
        local plyColor = Options.PlayerColor and Options.PlayerColor.Value or Color3.new(0, 0.8, 0.9)
        local npcColor = Options.NPCColor and Options.NPCColor.Value or Color3.new(1, 0.7, 0.1)
        local chestColor = Options.ChestColor and Options.ChestColor.Value or Color3.new(1, 0.4, 0.5)
        local fruitColor = Options.FruitColor and Options.FruitColor.Value or Color3.new(0.8, 0.2, 0.8)

        ClearESP()
        local char = LocalPlayer.Character
        if not char or not char.PrimaryPart then return end
        local pos = char.PrimaryPart.Position

        -- Players
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character.PrimaryPart
                if root and root.Position then
                    local dist = (pos - root.Position).Magnitude
                    if dist <= maxDist then
                        local hl = CreateHighlight(player.Character, plyColor)
                        hl.Parent = player.Character
                        table.insert(ESPObjects.Highlights, hl)
                        local bill = CreateBillboard(root, player.Name .. " | " .. math.floor(dist) .. "m", plyColor, Vector3.new(0, 4, 0))
                        bill.Parent = player.Character
                        table.insert(ESPObjects.Billboards, bill)
                    end
                end
            end
        end

        -- NPCs
        for _, obj in pairs(Workspace:GetDescendants()) do
            if IsNPC(obj) then
                local root = obj.HumanoidRootPart
                if root and root.Position then
                    local dist = (pos - root.Position).Magnitude
                    if dist <= maxDist then
                        local hl = CreateHighlight(obj, npcColor)
                        hl.Parent = obj
                        table.insert(ESPObjects.Highlights, hl)
                        local bill = CreateBillboard(root, obj.Name .. " | " .. math.floor(dist) .. "m", npcColor, Vector3.new(0, 4, 0))
                        bill.Parent = obj
                        table.insert(ESPObjects.Billboards, bill)
                    end
                end
            end
        end

        -- Chests & Fruits
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Part") then
                local name = obj.Name:lower()
                if name:find("chest") or name:find("loot") then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Handle") or (obj:IsA("Part") and obj)
                    if root and root.Position then
                        local dist = (pos - root.Position).Magnitude
                        if dist <= maxDist then
                            local hl = CreateHighlight(obj, chestColor)
                            hl.Parent = obj
                            table.insert(ESPObjects.Highlights, hl)
                            local bill = CreateBillboard(root, "📦 Chest | " .. math.floor(dist) .. "m", chestColor, Vector3.new(0, 2, 0))
                            bill.Parent = obj
                            table.insert(ESPObjects.Billboards, bill)
                        end
                    end
                elseif name:find("fruit") or name:find("devil") then
                    local root = obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("Part") and obj)
                    if root and root.Position then
                        local dist = (pos - root.Position).Magnitude
                        if dist <= maxDist then
                            local hl = CreateHighlight(obj, fruitColor)
                            hl.Parent = obj
                            table.insert(ESPObjects.Highlights, hl)
                            local bill = CreateBillboard(root, "🍎 Fruit | " .. math.floor(dist) .. "m", fruitColor, Vector3.new(0, 2, 0))
                            bill.Parent = obj
                            table.insert(ESPObjects.Billboards, bill)
                        end
                    end
                end
            end
        end
    end

    -- Start ESP loop
    RunService.Heartbeat:Connect(UpdateESP)
    LocalPlayer.CharacterAdded:Connect(ClearESP)

    -- // ============================================================
    -- // CONFIGURATION SYSTEM
    -- // ============================================================
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
    ThemeManager:SetFolder("ParadiseHub")
    SaveManager:SetFolder("ParadiseHub")
    SaveManager:SetSubFolder("BloxFruits")
    SaveManager:BuildConfigSection(Tabs.Settings)
    ThemeManager:ApplyToTab(Tabs.Settings)
    SaveManager:LoadAutoloadConfig()

