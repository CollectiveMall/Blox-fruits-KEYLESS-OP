-- Highlight Helper
local function CreateESP(instance, color, labelName, storageKey)
    if not instance or ESP_Cache[storageKey][instance] then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "Paradise_ESP"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = instance
    highlight.Parent = instance

    ESP_Cache[storageKey][instance] = highlight
end

local function ClearESPGroup(storageKey)
    for inst, hl in pairs(ESP_Cache[storageKey]) do
        if hl then hl:Destroy() end
    end
    table.clear(ESP_Cache[storageKey])
end

