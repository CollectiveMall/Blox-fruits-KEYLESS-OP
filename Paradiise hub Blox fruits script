ServerSec:CreateButton({
    Name = "Join small servers",
    Callback = function()
        local placeId = game.PlaceId
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        
        if req then
            local serversUrl = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            local response = req({Url = serversUrl, Method = "GET"})
            local body = HttpService:JSONDecode(response.Body)
            
            if body and body.data then
                for _, server in ipairs(body.data) do
                    if server.playing < server.maxPlayers and server.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        break
                    end
                end
            end
        else
            warn("[Paradise Hub] HTTP Request function not supported by executor.")
        end
    end
})

