    lbl.TextColor3 = LIGHT_PURPLE
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 16
    return lbl
end

local function AddToggle(parent, text, y, getter, setter)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.8, 0, 0, 30)
    btn.Position = UDim2.new(0.1, 0, 0, y)
    btn.BackgroundColor3 = BUTTON_BG
    btn.TextColor3 = LIGHT_PURPLE
    btn.Text = text .. " [OFF]"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        local newVal = not getter()
        setter(newVal)
        btn.Text = text .. (newVal and " [ON]" or " [OFF]")
    end)
    return btn
end

local function AddSlider(parent, text, y, min, max, default, getter, setter)
    local lbl = AddLabel(parent, text .. ": " .. tostring(default), y, 30)
    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0.3, 0, 0, 30)
    box.Position = UDim2.new(0.6, 0, 0, y)
    box.BackgroundColor3 = Color3.fromRGB(50, 40, 60)
    box.TextColor3 = LIGHT_PURPLE
    box.Text = tostring(default)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    local corner = Instance.new("UICorner", box)
    corner.CornerRadius = UDim.new(0, 6)
    box.FocusLost:Connect(function()
        local val = tonumber(box.Text)
        if val then
            val = math.clamp(val, min, max)
            setter(val)
            box.Text = tostring(val)
            lbl.Text = text .. ": " .. tostring(val)
        else
            box.Text = tostring(getter())
        end
    end)
    return box
end

local function AddButton(parent, text, y, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.Position = UDim2.new(0.1, 0, 0, y)
