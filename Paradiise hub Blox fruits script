-- // ESP ENGINE (Basic implementation)
-- // ============================================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local ESPObjects = {
    Highlights = {},
    Billboards = {},
    Lines = {},
    Glows = {},
}

function ClearESP()
    for _, v in pairs(ESPObjects.Highlights) do
        if v and v.Parent then v:Destroy() end
    end
    for _, v in pairs(ESPObjects.Billboards) do
        if v and v.Parent then v:Destroy() end
    end
    for _, v in pairs(ESPObjects.Lines) do
        if v and v.Parent then v:Destroy() end
    end
    for _, v in pairs(ESPObjects.Glows) do
        if v and v.Parent then v:Destroy() end
    end
    ESPObjects = { Highlights = {}, Billboards = {}, Lines = {}, Glows = {} }
end

local function CreateBillboard(adornee, text, color, offset)
    local bill = Instance.new("BillboardGui")
    bill.Adornee = adornee
    bill.Size = UDim2.new(0, 200, 0, 40)
    bill.StudsOffset = offset or Vector3.new(0, 3, 0)
    bill.MaxDistance = 500
    bill.AlwaysOnTop = true
    local label = Instance.new("TextLabel", bill)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0.3
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    return bill
end

local function CreateHighlight(adornee, color)
    local hl = Instance.new("Highlight")
    hl.Adornee = adornee
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    return hl
end

local function IsNPC(model)
    if not model or not model:IsA("Model") then return false end
    if not model:FindFirstChild("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if model.Humanoid.Health <= 0 then return false end
    local name = model.Name:lower()
    if name:find("npc") or name:find("enemy") or name:find("boss") or
       name:find("marine") or name:find("pirate") or name:find("bandit") or
       name:find("savage") or name:find("island") or name:find("guard") then
        return true
    end
    if model.Parent and model.Parent:IsA("Folder") then
        local pName = model.Parent.Name:lower()
        if pName:find("npc") or pName:find("enemy") or pName:find("boss") then
            return true
        end
    end
    return false
end

local function UpdateESP()
    if not Toggles.ESP_Toggle.Value or not isUnlocked then
        ClearESP()
        return
    end

    local maxDist = Options.DistanceSlider.Value or 250
    local showLines = Toggles.LineESP_Toggle.Value or false
    local showGlow = Toggles.Glow_Toggle.Value or true
    local plyColor = Options.PlayerColor.Value or Color3.new(0, 0.8, 0.9)
    local npcColor = Options.NPCColor.Value or Color3.new(1, 0.7, 0.1)
    local chestColor = Options.ChestColor.Value or Color3.new(1, 0.4, 0.5)
    local fruitColor = Options.FruitColor.Value or Color3.new(0.8, 0.2, 0.8)

    ClearESP()

    -- Players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if root and root.Position then
                local dist = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude or 999
                if dist <= maxDist then
                    local hl = CreateHighlight(char, plyColor)
                    hl.Parent = char
                    table.insert(ESPObjects.Highlights, hl)
                    local text = player.Name .. " | " .. math.floor(dist) .. "m"
                    local bill = CreateBillboard(root, text, plyColor, Vector3.new(0, 4, 0))
                    bill.Parent = char
                    table.insert(ESPObjects.Billboards, bill)
                end
            end
        end
    end

    -- NPCs
    for _, obj in pairs(Workspace:GetDescendants()) do
        if IsNPC(obj) then
            local root = obj.HumanoidRootPart
            if root and root.Position then
                local dist = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude or 999
                if dist <= maxDist then
                    local hl = CreateHighlight(obj, npcColor)
                    hl.Parent = obj
                    table.insert(ESPObjects.Highlights, hl)
                    local text = obj.Name .. " | " .. math.floor(dist) .. "m"
                    local bill = CreateBillboard(root, text, npcColor, Vector3.new(0, 4, 0))
                    bill.Parent = obj
                    table.insert(ESPObjects.Billboards, bill)
                end
            end
        end
    end

    -- Chests & Fruits (simplified)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            local name = obj.Name:lower()
            if name:find("chest") or name:find("loot") then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Handle") or (obj:IsA("Part") and obj)
                if root and root.Position then
                    local dist = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude or 999
                    if dist <= maxDist then
                        local hl = CreateHighlight(obj, chestColor)
                        hl.Parent = obj
                        table.insert(ESPObjects.Highlights, hl)
                        local text = "📦 Chest | " .. math.floor(dist) .. "m"
                        local bill = CreateBillboard(root, text, chestColor, Vector3.new(0, 2, 0))
                        bill.Parent = obj
                        table.insert(ESPObjects.Billboards, bill)
                    end
                end
            elseif name:find("fruit") or name:find("devil") then
                local root = obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("Part") and obj)
                if root and root.Position then
                    local dist = (LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position - root.Position).Magnitude or 999
                    if dist <= maxDist then
                        local hl = CreateHighlight(obj, fruitColor)
                        hl.Parent = obj
                        table.insert(ESPObjects.Highlights, hl)
                        local text = "🍎 Fruit | " .. math.floor(dist) .. "m"
                        local bill = CreateBillboard(root, text, fruitColor, Vector3.new(0, 2, 0))
                        bill.Parent = obj
                        table.insert(ESPObjects.Billboards, bill)
                    end
                end
            end
        end
    end
end

