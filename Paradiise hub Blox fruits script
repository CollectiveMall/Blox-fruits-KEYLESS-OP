function LoadObsidianGUI()
    -- Load Obsidian Library
    local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
    local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
    local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
    local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

    if not Library then
        warn("[Paradise Hub] Failed to load Obsidian Library.")
        return
    end

    -- Create Window
    local Window = Library:CreateWindow({
        Title = "🌴 Paradise Hub",
        Footer = "Community Edition",
        Icon = 95816097006870,
        NotifySide = "Right",
        ShowCustomCursor = true,
    })

    -- Tabs in order: AutoFarm → ESP → Utility → Settings
    local Tabs = {
        AutoFarm = Window:AddTab("⚔️ AutoFarm", "sword"),
        ESP = Window:AddTab("👁️ ESP", "eye"),
        Utility = Window:AddTab("🧰 Utility", "tool"),
        Settings = Window:AddTab("⚙️ Settings", "settings"),
    }

    -- // ============================================================
    -- // AUTOFARM TAB
    -- // ============================================================
    local AutoFarmGroup = Tabs.AutoFarm:AddLeftGroupbox("🌾 AutoFarm Controls", "sword")

    local farmToggle = AutoFarmGroup:AddToggle("Farm_Toggle", {
        Text = "Enable AutoFarm",
        Tooltip = "Toggle auto-farming on/off",
        Default = false,
        Risky = false,
        Callback = function(Value)
            print("[Paradise Hub] AutoFarm toggled:", Value)
            if Value then
                Library:Notify({
                    Title = "🌾 AutoFarm Started",
                    Description = "Farming in progress... (placeholder)",
                    Time = 3,
                })
            else
                Library:Notify({
                    Title = "🌾 AutoFarm Stopped",
                    Description = "Farming halted.",
                    Time = 2,
                })
            end
        end
    })

    AutoFarmGroup:AddSlider("FarmDistance", {
        Text = "Farm Range (studs)",
        Default = 150,
        Min = 50,
        Max = 400,
        Rounding = 0,
        Suffix = " studs",
        Tooltip = "How far to search for enemies",
        Callback = function(Value) end
    })

    AutoFarmGroup:AddSlider("AttackDelay", {
        Text = "Attack Speed (seconds)",
        Default = 0.3,
        Min = 0.1,
        Max = 1.0,
        Rounding = 1,
        Suffix = "s",
        Tooltip = "Delay between attacks",
        Callback = function(Value) end
    })

    AutoFarmGroup:AddToggle("WalkToNPC", {
        Text = "Walk to NPCs",
        Tooltip = "Automatically move towards the target NPC",
        Default = true,
