function ApplyLightPurpleTheme()
    local LightPurple = Color3.fromRGB(200, 150, 255)
    local function recolor(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextColor3 = LightPurple
        end
        for _, child in pairs(obj:GetChildren()) do
            recolor(child)
        end
    end
    -- Apply to all groupboxes
    for _, group in pairs({AutoFarmGroup, ESPGroup, UtilityGroup, SettingsGroup}) do
        if group then
            recolor(group)
        end
    end
end

