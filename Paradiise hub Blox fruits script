    })

    AutoFarmGroup:AddToggle("LootItems", {
        Text = "Auto-Loot Drops",
        Tooltip = "Automatically collect dropped fruits and items",
        Default = true,
        Callback = function(Value) end
    })

    AutoFarmGroup:AddDropdown("FarmTarget", {
        Values = { "All NPCs", "Bosses Only", "Lowest Level", "Highest Level" },
        Default = 1,
        Multi = false,
        Text = "Target Priority",
        Tooltip = "Which NPCs to prioritize",
        Callback = function(Value) end
    })

    AutoFarmGroup:AddLabel("Status: Idle", true)

    -- // ============================================================
    -- // ESP TAB (WITH TOGGLE)
    -- // ============================================================
    local ESPGroup = Tabs.ESP:AddLeftGroupbox("👁️ ESP Controls", "eye")

    local espToggle = ESPGroup:AddToggle("ESP_Toggle", {
        Text = "Enable ESP",
        Tooltip = "Turn the ESP system on/off",
        Default = false,
        Risky = false,
        Callback = function(Value)
            print("[Paradise Hub] ESP toggled:", Value)
            if not Value then
                ClearESP()
            end
        end
    })

    ESPGroup:AddSlider("DistanceSlider", {
        Text = "Max Distance (studs)",
