-- // Safety: prevent double execution
if getgenv().ParadiseHubLoaded then
    return
end
getgenv().ParadiseHubLoaded = true

-- // Load Obsidian Library with error handling
local Library, ThemeManager, SaveManager
local success, err = pcall(function()
    local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
    Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
    ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
    SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
end)

if not success then
    warn("[Paradise] Obsidian load failed: " .. tostring(err))
    -- Fallback: notify via a simple screen gui
    local notify = Instance.new("ScreenGui")
    notify.Name = "ParadiseError"
    notify.Parent = game:GetService("CoreGui")
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 600, 0, 100)
    label.Position = UDim2.new(0.5, -300, 0.5, -50)
    label.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    label.TextColor3 = Color3.fromRGB(255, 100, 100)
    label.Text = "Failed to load Obsidian library.\nCheck internet or re-run."
    label.TextSize = 24
    label.Font = Enum.Font.GothamBold
    label.Parent = notify
    return
end

-- // Configuration
Library.ForceCheckbox = false
Library.ShowToggleFrameInKeybinds = true

-- // Constants for Blox Fruits
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
