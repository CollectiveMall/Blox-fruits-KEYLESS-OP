local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")

local farmActive = false
local currentTarget = nil
local attackCooldown = false
local lootCooldown = false

-- // DETECT NPCs (Blox Fruits specific)
local function IsNPC(model)
    -- Must have Humanoid and HumanoidRootPart
    if not model:IsA("Model") then return false end
    if not model:FindFirstChild("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    -- Must NOT be a player
    if Players:GetPlayerFromCharacter(model) then return false end
    -- Must have health > 0
    if model.Humanoid.Health <= 0 then return false end
    -- Name filter (common NPC names in Blox Fruits)
    local name = model.Name:lower()
    if name:find("npc") or name:find("enemy") or name:find("boss") or name:find("marine") or name:find("pirate") or name:find("bandit") or name:find("savage") or name:find("island") then
        return true
    end
    -- Also detect by parent (often under "NPCs" or "Enemies" folder)
    if model.Parent and (model.Parent.Name:lower():find("npc") or model.Parent.Name:lower():find("enemy")) then
        return true
    end
    return false
end

-- // FIND NEAREST NPC
local function FindNearestNPC(range)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return nil end
    local pos = char.PrimaryPart.Position
    local nearest = nil
    local nearestDist = range

    for _, obj in pairs(Workspace:GetDescendants()) do
        if IsNPC(obj) then
            local root = obj.HumanoidRootPart
            if root and root.Position then
                local dist = (pos - root.Position).Magnitude
                if dist < nearestDist then
                    nearest = obj
                    nearestDist = dist
                end
            end
        end
    end
    return nearest, nearestDist
end

-- // MOVE TO TARGET
local function MoveToTarget(target)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    local root = target:FindFirstChild("HumanoidRootPart")
    if not root then return end
    humanoid:MoveTo(root.Position)
end

-- // ATTACK NPC (simulate click + ability)
local function AttackNPC(target)
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local root = target:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Face target
    char.PrimaryPart.CFrame = CFrame.lookAt(char.PrimaryPart.Position, root.Position)

    -- Simulate mouse click (for sword/melee)
    local mouse = LocalPlayer:GetMouse()
    if mouse then
        local camera = Workspace.CurrentCamera
        local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
        if onScreen then
            mouse.Move(mouse, screenPos.X, screenPos.Y)
            mouse.Button1Down(mouse)
            task.wait(0.05)
            mouse.Button1Up(mouse)
        end
    end

    -- Also use VirtualUser for reliable click (if available)
    pcall(function()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)

    -- Use ability (if you have a fruit equipped) – press 1, 2, 3 keys
    -- This is optional but we can simulate key presses
    pcall(function()
        -- Press Q for melee, or 1 for first ability
        VirtualUser:KeyDown("Q")
        task.wait(0.1)
        VirtualUser:KeyUp("Q")
    end)
end

-- // LOOT ITEMS (fruits, chests, etc.)
local function LootNearbyItems()
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local pos = char.PrimaryPart.Position
    local range = 20 -- Loot range

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") then
            local name = obj.Name:lower()
            if name:find("fruit") or name:find("chest") or name:find("loot") or name:find("money") then
                local root = obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("Part") and obj)
                if root and root.Position then
                    local dist = (pos - root.Position).Magnitude
                    if dist < range then
                        -- Walk to it and collect
                        local humanoid = char:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid:MoveTo(root.Position)
                            task.wait(0.2)
                            -- Simulate click to pick up
                            local mouse = LocalPlayer:GetMouse()
                            if mouse then
                                local camera = Workspace.CurrentCamera
                                local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                                if onScreen then
                                    mouse.Move(mouse, screenPos.X, screenPos.Y)
                                    mouse.Button1Down(mouse)
                                    task.wait(0.05)
                                    mouse.Button1Up(mouse)
                                end
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end

-- // MAIN AUTOFARM LOOP
local function AutoFarmLoop()
    while isUnlocked and RunService.Heartbeat do
        if not Toggles.Farm_Toggle.Value then
            farmActive = false
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Idle")
            end
            task.wait(0.5)
            goto continue
        end

        farmActive = true
        local range = Options.FarmDistance.Value or 150
        local target, dist = FindNearestNPC(range)

        if target then
            currentTarget = target
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Farming " .. target.Name .. " (" .. math.floor(dist) .. "m)")
            end

            -- Move to target
            if Toggles.WalkToNPC.Value then
                MoveToTarget(target)
            end

            -- Attack
            if not attackCooldown then
                attackCooldown = true
                AttackNPC(target)
                task.wait(Options.AttackDelay.Value or 0.3)
                attackCooldown = false
            end

            -- Loot items
            if Toggles.LootItems.Value and not lootCooldown then
                lootCooldown = true
                LootNearbyItems()
                task.wait(0.5)
                lootCooldown = false
            end

            -- Check if target is dead
            if target.Humanoid.Health <= 0 then
                currentTarget = nil
                if Options.FarmStatus then
                    Options.FarmStatus:SetText("Status: Target defeated, searching...")
                end
                task.wait(0.5) -- Wait for respawn
            end
        else
            if Options.FarmStatus then
                Options.FarmStatus:SetText("Status: Searching for NPCs...")
            end
            currentTarget = nil
            task.wait(0.3)
        end

        ::continue::
        task.wait(0.1)
    end
end

-- // START AUTOFARM LOOP
spawn(AutoFarmLoop)

